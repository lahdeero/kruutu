#!/bin/bash

CARD="alsa_card.pci-0000_09_00.1"
ANALOG_SINK="alsa_output.pci-0000_0b_00.3.analog-stereo"

MAIN="DP-3"
SECONDARY="DP-2"
TV="HDMI-A-1"

errormsg="Invalid usage. Use $0 {1,2,3,4}. For example: $0 2"

find_profile() {
    local monitor="$1"

    pactl list cards |
        awk -v monitor="$monitor" '
            /^[[:space:]]*hdmi-output-/ {
                target = 0
            }

            $0 ~ "device.product.name = \"" monitor "\"" {
                target = 1
            }

            target && /Part of profile\(s\):/ {
                if (match($0, /output\\?:hdmi-stereo(-extra[0-9]+)?/)) {
                    profile = substr($0, RSTART, RLENGTH)
                    gsub(/\\:/, ":", profile)
                    print profile
                    exit
                }
            }
        '
}

wait_for_sink() {
    local sink="$1"

    for _ in {1..20}; do
        if pactl list short sinks |
            awk -v sink="$sink" '$2 == sink { found=1 } END { exit !found }'; then
            return 0
        fi

        sleep 0.2
    done

    echo "Sink did not appear: $sink"
    return 1
}

set_default_sink() {
    local sink="$1"

    if ! wait_for_sink "$sink"; then
        return 1
    fi

    echo "Using audio sink: $sink"

    pactl set-default-sink "$sink"

    # Move already-running applications to the new sink.
    pactl list short sink-inputs |
        awk '{print $1}' |
        while read -r input; do
            pactl move-sink-input "$input" "$sink" 2>/dev/null || true
        done
}

tvsound() {
    local profile
    local sink
    local attempt

    # HDMI/ELD discovery can lag behind enabling the TV.
    # Do not assume that S90D is hdmi-stereo or hdmi-stereo-extra1:
    # determine its current profile dynamically.
    for attempt in {1..40}; do
        profile=$(find_profile "S90D")

        if [ -n "$profile" ] &&
            pactl set-card-profile "$CARD" "$profile" 2>/dev/null; then

            sink="alsa_output.pci-0000_09_00.1.${profile#output:}"

            if pactl list short sinks |
                awk -v sink="$sink" '$2 == sink { found=1 } END { exit !found }'; then

                echo "S90D audio profile: $profile"
                set_default_sink "$sink"
                return $?
            fi
        fi

        sleep 0.25
    done

    echo "S90D HDMI audio did not become ready within 10 seconds"
    return 1
}

computersound() {
    # Never use the ROG monitor for audio.
    pactl set-card-profile "$CARD" off 2>/dev/null || true

    set_default_sink "$ANALOG_SINK"
}

disabletv() {
    echo "Disabling TV ($TV)"
    kscreen-doctor "output.$TV.disable" >/dev/null 2>&1 || true
}

set_panel_hiding() {
    local mode="$1"

    qdbus6 org.kde.plasmashell \
        /PlasmaShell \
        org.kde.PlasmaShell.evaluateScript \
        "var p = panelById(57); if (p) { p.hiding = \"$mode\"; }"
}

case "$1" in
    1)
        echo "Secondary + main (extended). Main monitor is on the right."

        kscreen-doctor \
            "output.$SECONDARY.enable" \
            "output.$SECONDARY.position.0,0" \
            "output.$MAIN.enable" \
            "output.$MAIN.position.1920,0" \
            "output.$MAIN.primary"

        disabletv
        set_panel_hiding none
        computersound
        ;;

    2)
        echo "Main + TV (mirrored)"

        kscreen-doctor \
            "output.$MAIN.enable" \
            "output.$MAIN.position.0,0" \
            "output.$MAIN.primary" \
            "output.$TV.enable" \
            "output.$TV.position.0,0" \
            "output.$SECONDARY.disable"

        set_panel_hiding autohide
        tvsound
        ;;

    3)
        echo "Main monitor only"

        kscreen-doctor \
            "output.$MAIN.enable" \
            "output.$MAIN.position.0,0" \
            "output.$MAIN.primary" \
            "output.$SECONDARY.disable"

        disabletv
        set_panel_hiding none
        computersound
        ;;

    4)
        echo "TV + secondary + main (TV left, secondary middle, main right)"

        kscreen-doctor \
            "output.$TV.enable" \
            "output.$TV.position.0,0" \
            "output.$SECONDARY.enable" \
            "output.$SECONDARY.position.2560,0" \
            "output.$MAIN.enable" \
            "output.$MAIN.position.4480,0" \
            "output.$MAIN.primary"

        set_panel_hiding none
        computersound
        ;;

    *)
        echo "$errormsg"
        exit 1
        ;;
esac