#!/bin/bash

CARD="alsa_card.pci-0000_09_00.1"

errormsg="Invalid usage. Use $0 {1,2,3,4}. For example: $0 2"

set_default_sink() {
    local pattern="$1"
    local sink
    local streams

    sink=$(wpctl status |
        awk -v pat="$pattern" '
            /Sinks:/,/Sources:/ {
                if ($0 ~ pat) {
                    match($0, /[0-9]+\./)
                    print substr($0, RSTART, RLENGTH-1)
                    exit
                }
            }')

    [ -z "$sink" ] && {
        echo "Could not find sink matching '$pattern'"
        return 1
    }

    echo "Using sink $sink"

    wpctl set-default "$sink"

    # Move existing playback streams to the new sink.
    streams=$(wpctl status |
        awk '
            /Streams:/,/Video/ {
                if ($1 ~ /^[0-9]+\.$/) {
                    id=$1
                    sub(/\./,"",id)
                    print id
                }
            }')

    for stream in $streams; do
        wpctl move "$stream" "$sink" 2>/dev/null
    done
}

tvsound() {
    pactl set-card-profile "$CARD" output:hdmi-stereo
    sleep 1
    set_default_sink "Digital Stereo \\(HDMI\\)"
}

computersound() {
    pactl set-card-profile "$CARD" output:hdmi-stereo-extra1
    sleep 1
    set_default_sink "Family 17h .* Analog Stereo"
}

disabletv() {
    echo "Disabling TV (HDMI-A-1)"
    kscreen-doctor output.HDMI-A-1.disable >/dev/null 2>&1 || true
}

case "$1" in
    1)
        echo "DP-3 + DP-2 (extended). DP-2 is the primary display on the right."
        kscreen-doctor \
            output.DP-3.enable \
            output.DP-3.position.0,0 \
            output.DP-2.enable \
            output.DP-2.position.1920,0 \
            output.DP-2.primary
        disabletv
        computersound
        ;;

    2)
        echo "DP-2 + HDMI-A-1 (mirrored)"
        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-2.primary \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.disable
        tvsound
        ;;

    3)
        echo "DP-2 only"
        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-2.primary \
            output.DP-3.disable
        disabletv
        computersound
        ;;

    4)
        echo "HDMI-A-1 + DP-3 + DP-2 (HDMI left, DP-3 middle, DP-2 right)"
        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.enable \
            output.DP-3.position.2560,0 \
            output.DP-2.enable \
            output.DP-2.position.4480,0 \
            output.DP-2.primary
        computersound
        ;;

    *)
        echo "$errormsg"
        exit 1
        ;;
esac