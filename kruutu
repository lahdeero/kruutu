#!/bin/bash

CARD="alsa_card.pci-0000_09_00.1"
ANALOG_SINK="alsa_output.pci-0000_0b_00.3.analog-stereo"

# Current display mapping:
# DP-3     = main monitor (ROG PG279Q, 2560x1440@144)
# DP-2     = secondary monitor (1920x1080@60)
# HDMI-A-1 = TV (S90D)
#
# Known mode IDs:
# DP-3:
#   2  = 2560x1440@144
#
# HDMI-A-1:
#   36 = 2560x1440@59.95
#   39 = 1920x1080@60.00

errormsg="Invalid usage. Use $0 {1,2,3,4}. For example: $0 2"

find_profile() {
    local monitor="$1"

    pactl list cards |
        awk -v monitor="$monitor" '
            /^[[:space:]]*hdmi-output-/ {
                target = 0
            }

            $0 ~ "device.product.name = \"" monitor "\"" {
                target = 1
            }

            target && /Part of profile\(s\):/ {
                if (match($0, /output\\?:hdmi-stereo(-extra[0-9]+)?/)) {
                    profile = substr($0, RSTART, RLENGTH)
                    gsub(/\\:/, ":", profile)
                    print profile
                    exit
                }
            }
        '
}

wait_for_sink() {
    local sink="$1"

    for _ in {1..20}; do
        if pactl list short sinks |
            awk -v sink="$sink" '$2 == sink { found=1 } END { exit !found }'; then
            return 0
        fi

        sleep 0.2
    done

    echo "Sink did not appear: $sink"
    return 1
}

set_default_sink() {
    local sink="$1"

    if ! wait_for_sink "$sink"; then
        return 1
    fi

    echo "Using audio sink: $sink"

    pactl set-default-sink "$sink"

    # Move already-running applications to the new sink.
    pactl list short sink-inputs |
        awk '{print $1}' |
        while read -r input; do
            pactl move-sink-input "$input" "$sink" 2>/dev/null || true
        done
}

tvsound() {
    local profile
    local sink
    local attempt

    # HDMI audio discovery can lag behind enabling the TV picture.
    for attempt in {1..40}; do
        profile=$(find_profile "S90D")

        if [ -n "$profile" ] &&
            pactl set-card-profile "$CARD" "$profile" 2>/dev/null; then

            sink="alsa_output.pci-0000_09_00.1.${profile#output:}"

            if pactl list short sinks |
                awk -v sink="$sink" '$2 == sink { found=1 } END { exit !found }'; then

                echo "S90D audio profile: $profile"
                set_default_sink "$sink"
                return $?
            fi
        fi

        sleep 0.25
    done

    echo "S90D HDMI audio did not become ready within 10 seconds"
    return 1
}

computersound() {
    # Never use audio from the ROG monitor.
    # Disable NVIDIA audio entirely when using computer speakers.
    pactl set-card-profile "$CARD" off 2>/dev/null || true

    set_default_sink "$ANALOG_SINK"
}

disabletv() {
    echo "Disabling TV (HDMI-A-1)"
    kscreen-doctor output.HDMI-A-1.disable >/dev/null 2>&1 || true
}

set_panel_hiding() {
    local mode="$1"

    qdbus6 org.kde.plasmashell \
        /PlasmaShell \
        org.kde.PlasmaShell.evaluateScript \
        "var p = panelById(57); if (p) { p.hiding = \"$mode\"; }"
}

case "$1" in
    1)
        echo "Secondary + main (extended). Main monitor is on the right."

        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-3.enable \
            output.DP-3.position.1920,0 \
            output.DP-3.primary

        disabletv
        set_panel_hiding none
        computersound
        ;;

    2)
        echo "Main + TV (mirrored)"
        echo "Preparing TV HDMI connection"

        # The S90D sometimes rejects the desired resolution after the
        # HDMI connection has been initialized. Switching it to 1080p60
        # first reliably resets the link.
        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.mode.39 \
            output.HDMI-A-1.position.0,0

        sleep 1

        # Switch the TV to 1440p and put the main monitor at the same
        # position, giving us the mirrored desktop.
        kscreen-doctor \
            output.HDMI-A-1.mode.36 \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.enable \
            output.DP-3.mode.2 \
            output.DP-3.position.0,0 \
            output.DP-3.primary \
            output.DP-2.disable

        set_panel_hiding autohide
        tvsound
        ;;

    3)
        echo "Main monitor only"

        kscreen-doctor \
            output.DP-3.enable \
            output.DP-3.position.0,0 \
            output.DP-3.primary \
            output.DP-2.disable

        disabletv
        set_panel_hiding autohide
        computersound
        ;;

    4)
        echo "TV + secondary + main"

        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-2.enable \
            output.DP-2.position.2560,0 \
            output.DP-3.enable \
            output.DP-3.position.4480,0 \
            output.DP-3.primary

        set_panel_hiding none
        computersound
        ;;

    *)
        echo "$errormsg"
        exit 1
        ;;
esac