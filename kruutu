#!/bin/bash

CARD="alsa_card.pci-0000_09_00.1"

find_profile() {
    local monitor="$1"

    pactl list cards |
    awk -v mon="$monitor" '
    $0 ~ "device.product.name = \"" mon "\"" {
        found=1
        next
    }

    found && /Part of profile/ {
        match($0,/output:[^, ]+/)
        print substr($0,RSTART,RLENGTH)
        exit
    }'
}

set_default_sink() {
    local pattern="$1"
    local sink

    sink=$(
        wpctl status |
        awk -v pat="$pattern" '
        /Sinks:/,/Sources:/ {
            if ($0 ~ pat) {
                match($0,/[0-9]+\./)
                print substr($0,RSTART,RLENGTH-1)
                exit
            }
        }'
    )

    [ -z "$sink" ] && return 1

    wpctl set-default "$sink"

    wpctl status |
    awk '
    /Streams:/,/Video/ {
        if ($1 ~ /^[0-9]+\.$/) {
            gsub(/\./,"",$1)
            print $1
        }
    }' |
    while read -r stream; do
        wpctl move "$stream" "$sink" 2>/dev/null
    done
}

tvsound() {
    local profile

    profile=$(find_profile "S90D")

    if [ -z "$profile" ]; then
        echo "Could not find S90D HDMI profile."
        return 1
    fi

    echo "Using TV profile: $profile"

    pactl set-card-profile "$CARD" "$profile"
    sleep 1

    set_default_sink "GB205 High Definition Audio Controller Digital Stereo"
}

computersound() {
    pactl set-card-profile "$CARD" off
    sleep 0.5

    set_default_sink "Family 17h .* Analog Stereo"
}

disabletv() {
    echo "Disabling TV (HDMI-A-1)"
    kscreen-doctor output.HDMI-A-1.disable >/dev/null 2>&1 || true
}

case "$1" in
    1)
        echo "DP-3 + DP-2 (extended). DP-2 is the primary display on the right."
        kscreen-doctor \
            output.DP-3.enable \
            output.DP-3.position.0,0 \
            output.DP-2.enable \
            output.DP-2.position.1920,0 \
            output.DP-2.primary
        disabletv
        computersound
        ;;

    2)
        echo "DP-2 + HDMI-A-1 (mirrored)"
        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-2.primary \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.disable
        tvsound
        ;;

    3)
        echo "DP-2 only"
        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-2.primary \
            output.DP-3.disable
        disabletv
        computersound
        ;;

    4)
        echo "HDMI-A-1 + DP-3 + DP-2 (HDMI left, DP-3 middle, DP-2 right)"
        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.enable \
            output.DP-3.position.2560,0 \
            output.DP-2.enable \
            output.DP-2.position.4480,0 \
            output.DP-2.primary
        computersound
        ;;

    *)
        echo "$errormsg"
        exit 1
        ;;
esac