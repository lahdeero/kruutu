#!/bin/bash

errormsg="Invalid usage. Use $0 {1,2,3,4}. For example: $0 2"

tvsound() {
    pactl set-card-profile alsa_card.pci-0000_09_00.1 output:hdmi-stereo \
        || echo "Failed to switch to TV audio profile"
    sleep 1

    local sink
    sink=$(wpctl status |
        awk '/Sinks:/,/Sources:/ {
            if ($0 ~ /Digital Stereo \(HDMI\)/) {
                match($0, /[0-9]+\./)
                print substr($0, RSTART, RLENGTH-1)
            }
        }')

    if [ -n "$sink" ]; then
        wpctl set-default "$sink"
    fi
}

computersound() {
    pactl set-card-profile alsa_card.pci-0000_09_00.1 output:hdmi-stereo-extra1 \
        || echo "Failed to switch to computer audio profile"
    sleep 1

    local sink
    sink=$(wpctl status |
        awk '/Sinks:/,/Sources:/ {
            if ($0 ~ /Family 17h .* Analog Stereo/) {
                match($0, /[0-9]+\./)
                print substr($0, RSTART, RLENGTH-1)
            }
        }')

    [ -n "$sink" ] && wpctl set-default "$sink"
}

disabletv() {
    echo "Disabling TV (HDMI-A-1)"
    kscreen-doctor output.HDMI-A-1.disable >/dev/null 2>&1 || true
}

case "$1" in
    1)
        echo "DP-3 + DP-2 (extended). DP-2 is the primary display on the right."
        kscreen-doctor \
            output.DP-3.enable \
            output.DP-3.position.0,0 \
            output.DP-2.enable \
            output.DP-2.position.1920,0 \
            output.DP-2.primary
        disabletv
        computersound
        ;;

    2)
        echo "DP-2 + HDMI-A-1 (mirrored)"
        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-2.primary \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.disable
        tvsound
        ;;

    3)
        echo "DP-2 only"
        kscreen-doctor \
            output.DP-2.enable \
            output.DP-2.position.0,0 \
            output.DP-2.primary \
            output.DP-3.disable
        disabletv
        computersound
        ;;

    4)
        echo "HDMI-A-1 + DP-3 + DP-2 (HDMI left, DP-3 middle, DP-2 right)"
        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.enable \
            output.DP-3.position.2560,0 \
            output.DP-2.enable \
            output.DP-2.position.4480,0 \
            output.DP-2.primary
        computersound
        ;;

    *)
        echo "$errormsg"
        exit 1
        ;;
esac